<!--Models v3 -->
<section id="models" class="py-24 bg-white">
    <div class="container mx-auto px-4">
        
        <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900">Пълна колекция</h2>
            <p class="text-slate-500 mt-2">Изберете категория, за да разгледате</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            
            {models.map((item) => (
                <a href={`${base}/models/${item.link}`} class="group relative h-64 md:h-80 rounded-2xl overflow-hidden cursor-pointer shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                    
                    <img 
                        src={item.img} 
                        alt={item.title}
                        class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110 group-hover:rotate-1"
                    />
                    
                    <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent opacity-60 group-hover:opacity-90 transition duration-300"></div>
                    
                    <div class="absolute bottom-0 left-0 w-full p-4 text-center transform translate-y-2 group-hover:translate-y-0 transition duration-300">
                        <p class="text-blue-400 text-xs font-bold uppercase tracking-wider mb-1 opacity-0 group-hover:opacity-100 transition duration-300 delay-75">
                            {item.subtitle}
                        </p>
                        <h3 class="text-xl md:text-2xl font-bold text-white mb-2">{item.title}</h3>
                        
                        <div class="w-0 h-0.5 bg-white mx-auto group-hover:w-12 transition-all duration-300"></div>
                    </div>

                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300 delay-100 pointer-events-none">
                        <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm border border-white/50 flex items-center justify-center text-white">
                            ↗
                        </div>
                    </div>
                </a>
            ))}

        </div>
    </div>
</section>

