---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

	const models = [
  // 1. Вертикални
  { 
    title: "Вертикални", 
    subtitle: "Текстил и PVC", 
    img: `${base}/images/vertical/vertical-sample.png`, 
    link: "vertical" 
  },
  
  // 2. Венециански
  { 
    title: "Венециански", 
    subtitle: "Алуминиеви", 
    img: `${base}/images/venetian/venetian-sample.png`, 
    link: "venetian" 
  },

  // 3. Плисе
  { 
    title: "Плисе", 
    subtitle: "Стандарт & Ден и Нощ", 
    img: `${base}/images/plise/plise-sample.png`, 
    link: "plise" 
  },

  // 4. Дървени
  { 
    title: "Дървени", 
    subtitle: "Естествено дърво", 
    img: `${base}/images/wooden/wooden-sample.png`, 
    link: "wooden" 
  },

  // 5. Римски (Тук влизат Делукс, Мини, Макс, Бокс)
  { 
    title: "Римски", 
    subtitle: "Делукс, Макс & Бокс", 
    img: `${base}/images/roman/roman-sample.jpg`	, 
    link: "roman" 
  },

  // 6. Руло (Тук влизат Кутия, Водачи, Макс)
  { 
    title: "Руло щори", 
    subtitle: "С кутия и водачи", 
    img: `${base}/images/roller/roller-sample.jpg`, 
    link: "roller" 
  },

  // 7. Ден и Нощ (Зебра)
  { 
    title: "Ден и Нощ", 
    subtitle: "Стандарт & Макс Бокс", 
    img: `${base}/images/day-night/day-night-sample.png`, 
    link: "day-night" 
  },

  // 8. Хармония
  { 
    title: "Хармония", 
    subtitle: "Ефирна елегантност", 
    img: `${base}/images/harmony/harmony-sample.png`, 
    link: "harmony" 
  },

  // 9. Вертикални Ден и Нощ
  { 
    title: "Верт. Ден и Нощ", 
    subtitle: "Иновация 2 в 1", 
    img: `${base}/images/vertical-day-night/vertical-day-night-sample.jpg`, 
    link: "vertical-day-night" 
  },

  // 10. Автоматизирани релси
  { 
    title: "Ел. Корнизи", 
    subtitle: "Автоматизация Somfy", 
    img: `${base}/images/motorized/motorized-sample.jpg`, 
    link: "motorized" 
  },
];
---

<Layout title="Rio Homes - Елегантни решения за вашия дом">
	
	<section class="relative h-[80vh] min-h-150 flex items-center justify-center overflow-hidden">
		<div class="absolute inset-0 z-0">
				<img 
					src={`${base}/hero.png`} 
					alt="Модерни щори в хол и офис" 
					class="w-full h-full object-cover scale-105 animate-slow-zoom" 
				/>
			<div class="absolute inset-0 bg-linear-to-r from-slate-900/80 to-slate-900/40"></div>
		</div>

		<div class="relative z-10 text-center text-white px-6 max-w-4xl mx-auto">
			<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight drop-shadow-lg">
				Съвършена светлина <br/> във вашия дом.
			</h1>
			<p class="text-xl md:text-2xl text-slate-200 mb-10 max-w-2xl mx-auto font-light">
				Преобразете пространството си с нашите премиум щори по индивидуален размер. Комфорт и стил, които заслужавате.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href={`${base}/#contact`} class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-10 rounded-full transition transform hover:-translate-y-1 shadow-lg hover:shadow-blue-500/30">
					Заяви безплатен оглед
				</a>
				<a href={`${base}/#models`} class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white font-semibold py-4 px-10 rounded-full transition border border-white/30">
					Разгледай моделите
				</a>
			</div>
		</div>
	</section>


