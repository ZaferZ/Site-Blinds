<Layout title="Rio Homes - Елегантни решения за вашия дом">



<!-- Hero slider -->
	<section class="relative h-full min-h-150 overflow-hidden bg-slate-900">
        
        <div id="hero-slider" class="absolute inset-0 w-full h-full">
            {slides.map((slide, index) => (
                <div 
                    class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                    data-index={index}
                >
                    <div class="absolute inset-0">
                        <img src={slide.image} alt={slide.title} class="w-full h-full object-cover"/>
                        <div class="absolute inset-0 bg-black/40"></div>
                    </div>

                    <div class="relative z-20 container mx-auto px-6 h-full flex flex-col justify-center items-center text-center">
                        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 drop-shadow-lg transform translate-y-0 transition-all duration-700 delay-100 slide-content opacity-0">
                            {slide.title}
                        </h1>
                        <p class="text-lg md:text-2xl text-slate-100 mb-10 max-w-2xl drop-shadow-md transform translate-y-4 transition-all duration-700 delay-300 slide-content opacity-0">
                            {slide.subtitle}
                        </p>
                        
                        <div class="transform translate-y-4 transition-all duration-700 delay-500 slide-content opacity-0">
                            <a href={slide.link} class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-10 rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg">
                                {slide.buttonText}
                            </a>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <div class="absolute bottom-10 left-0 w-full flex justify-center gap-3 z-30">
            {slides.map((_, index) => (
                <button 
                    class={`slider-dot w-3 h-3 rounded-full transition-all duration-300 ${index === 0 ? 'bg-white w-8' : 'bg-white/50 hover:bg-white'}`}
                    data-index={index}
                    aria-label={`Slide ${index + 1}`}
                ></button>
            ))}
        </div>
    </section>
	<script>
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.slider-dot');
    const intervalTime = 5000;
    
    // Дефинираме типа като any, за да избегнем TS грешки при setInterval в браузъра
    let slideInterval: any; 
    let activeIndex: number = 0;

    // Функция за анимация на текста отдолу-нагоре
    function animateText(index: number) {
        document.querySelectorAll('.slide-content').forEach((el) => {
            el.classList.remove('opacity-100', 'translate-y-0');
            el.classList.add('opacity-0', 'translate-y-4');
        });

        const activeSlide = slides[index];
        if (activeSlide) {
            const contentElements = activeSlide.querySelectorAll('.slide-content');
            setTimeout(() => {
                contentElements.forEach((el) => {
                    el.classList.remove('opacity-0', 'translate-y-4');
                    el.classList.add('opacity-100', 'translate-y-0');
                });
            }, 100);
        }
    }

    // Смяна на конкретен слайд
    function changeSlide(index: number) {
        if (!slides[activeIndex] || !slides[index]) return;

        // Скрива стария
        slides[activeIndex].classList.remove('opacity-100', 'z-10');
        slides[activeIndex].classList.add('opacity-0', 'z-0');
        dots[activeIndex].classList.remove('bg-white', 'w-8');
        dots[activeIndex].classList.add('bg-white/50');

        // Актуализира индекса
        activeIndex = index;

        // Показва новия
        slides[activeIndex].classList.remove('opacity-0', 'z-0');
        slides[activeIndex].classList.add('opacity-100', 'z-10');
        dots[activeIndex].classList.remove('bg-white/50');
        dots[activeIndex].classList.add('bg-white', 'w-8');

        // Пуска текстовата анимация
        animateText(activeIndex);
    }

    // Отиване на следващ слайд (завърта се отначало, ако стигне края)
    function nextSlide() {
        let nextIndex = (activeIndex + 1) % slides.length;
        changeSlide(nextIndex);
    }

    // Стартираме автоматичното превъртане
    slideInterval = setInterval(nextSlide, intervalTime);

    // Слушаме за клик върху точките
    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const indexStr = dot.getAttribute('data-index');
            if (indexStr) {
                const index = parseInt(indexStr);
                // Спираме стария таймер и пускаме нов, за да не прескочи рязко
                clearInterval(slideInterval);
                changeSlide(index);
                slideInterval = setInterval(nextSlide, intervalTime);
            }
        });
    });

    // Инициализираме текстовата анимация за първия слайд веднага
    animateText(0);
</script>

